# Copy to .env and fill in. .env is gitignored and must never be committed.
# The server reads it at start; anything already set in the real environment wins.

# --- Language model providers ------------------------------------------------
# Chain order. Providers without a key are skipped, so any subset works; with no
# keys at all the system runs on deterministic offline extraction.
RESQMESH_LLM_ORDER=gemini,groq,deepseek
# Primary: Gemini Flash (default gemini-3.6-flash; override with RESQMESH_GEMINI_MODEL).
# Free tier, no card. Also reads damage photos.
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Failover: Groq (default openai/gpt-oss-120b; override with RESQMESH_GROQ_MODEL). Free, text only.
GROQ_API_KEY=
# Optional paid failover. Leave blank to skip.
DEEPSEEK_API_KEY=
RESQMESH_DEEPSEEK_MODEL=deepseek-flash
# Ollama is supported but not in the default chain. Add "ollama" to RESQMESH_LLM_ORDER
# on a machine that can run it.
OLLAMA_BASE_URL=http://localhost:11434

# --- Broadcast ----------------------------------------------------------------
# Leave blank to run without a Telegram bot: the full pipeline still works.
TELEGRAM_BOT_TOKEN=
# Public channel that approved alerts are pushed to (@name or a numeric id the bot
# administers). With this set AND a bot token, an approved alert is broadcast to the
# channel. Blank: alerts still show in the console and on /news.
RESQMESH_ALERT_TELEGRAM_CHAT=
# Secret passed to Telegram's setWebhook; the webhook is disabled without it. Setting
# it also turns long-polling off (Telegram allows one or the other).
TELEGRAM_WEBHOOK_SECRET=
# auto (default): poll the bot when a token is set. off: never poll.
RESQMESH_TELEGRAM=auto

# --- What the server starts with ----------------------------------------------
# 1 opens the synthetic Kelani incident with its first wave of reports at start, so
# there is a running system to look at. Blank starts empty: open the incident from the
# console and feed reports from /report.
RESQMESH_DEMO=
# synthetic (default; nothing to download) or real (the fetched Kelani basin).
RESQMESH_WORLD=synthetic
# Replay clock for the real world's rainfall, UTC. Default 2016-05-14T06:00 (two days
# before the disaster peaked); 2016-05-16T00:00 is the peak itself.
RESQMESH_AT=
# live (the provider chain above, rules last) or offline (no hosted-model calls).
RESQMESH_LLM=live
# Set to 1 to force degraded mode (no network) for chaos testing.
RESQMESH_OFFLINE=0
RESQMESH_DATA_DIR=./data
RESQMESH_OUTPUTS_DIR=./outputs
# Host name the enrolment links point at.
RESQMESH_PUBLIC_HOST=localhost:8000

# --- Sign-in --------------------------------------------------------------------
# How the console authenticates:
#   accounts  real users, sessions and responder enrolment. Use this to deploy: it is the
#             only mode in which an approval records *who* approved.
#   static    two shared tokens (below). A single-operator demo.
#   open      no sign-in at all. Local development only.
# Left blank, it is "static" when a token is set and "open" otherwise.
RESQMESH_AUTH_MODE=
# Accounts mode with no accounts yet: the server prints a one-time setup code and /console
# offers a first-commander form. Pin the code here for an unattended deployment; leave it
# blank and one is generated per start. Ignored once any account exists.
RESQMESH_SETUP_CODE=
# Static mode only.
RESQMESH_COMMANDER_TOKEN=
RESQMESH_VIEWER_TOKEN=
# Salt for pseudonymising reporter ids. Set a long random value and keep it stable, or
# source trust resets on every restart.
RESQMESH_SALT=
# Key that signs session tokens. The built-in default is public: set a long random value
# on anything reachable from a network.
JAC_SERVE_AUTH_SECRET=
